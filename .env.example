# Copia este archivo a .env.local (local) o .env (VPS).
# Nunca subas .env ni .env.local a git.

NEXOROUTER_API_KEY=
NEXOROUTER_MODEL=kimi-k2.6

# Auth.js — genere uno con: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth (también se aceptan AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos Google del docente, separados por coma
TEACHER_EMAILS=

# Dominios institucionales permitidos para estudiantes
ALLOWED_EMAIL_DOMAINS=est.umss.edu,umss.edu.bo,umss.edu

# Opcional. Por defecto: .eve/.workflow-data/aula.sqlite
# AULA_DB_PATH=
